      {
        "id": "result-cards",
        "role": "component.FeatureCardGrid",
        "label": "Generated creative plan cards",
        "layerId": "result-cards-layer",
        "elementId": "story-card"
      },
      {
        "id": "revival-hub",
        "role": "brand.finalHub",
        "label": "Final Revival native scene intelligence hub",
        "layerId": "final-hub-layer",
        "elementId": "final-hub-panel"
      }
    ],
    "beats": [
      {
        "id": "icon-establish",
        "label": "App icon establishes trust",
        "startMs": 0,
        "endMs": 1800,
        "intent": "A clean Revival icon settles in the center with calm premium motion.",
        "componentRefs": ["app-icon"]
      },
      {
        "id": "prompt-handoff",
        "label": "Icon hands off to input",
        "startMs": 1800,
        "endMs": 4300,
        "intent": "The icon yields to a native prompt input; text types inside a fixed frame.",
        "componentRefs": ["app-icon", "prompt-input", "prompt-copy"]
      },
      {
        "id": "prompt-readable-hold",
        "label": "Prompt readable hold",
        "startMs": 4300,
        "endMs": 4800,
        "intent": "The completed prompt remains readable before the send press.",
        "componentRefs": ["prompt-input", "prompt-copy"]
      },
      {
        "id": "generate-press",
        "label": "Send press resolves",
        "startMs": 4800,
        "endMs": 6100,
        "intent": "The send button presses inward and the prompt resolves into generated structure.",
        "componentRefs": ["prompt-input"]
      },
      {
        "id": "cards-assemble",
        "label": "Professional output cards assemble",
        "startMs": 6100,
        "endMs": 9800,
        "intent": "Three readable cards assemble with clear spacing and no loose text.",
        "componentRefs": ["result-cards"]
      },
      {
        "id": "final-hold",
        "label": "Final product promise",
        "startMs": 9800,
        "endMs": 14000,
        "intent": "A dark final hub holds long enough to read the product promise.",
        "componentRefs": ["revival-hub"]
      }
    ],
    "primitives": [
      {
        "id": "icon-pop",
        "beatId": "icon-establish",
        "targetComponentId": "app-icon",
        "kind": "scale",
        "property": "scale",
        "startMs": 0,
        "endMs": 1100,
        "fromValue": 0.72,
        "toValue": 1,
        "easing": "slowFastSlow"
      },
      {
        "id": "prompt-type",
        "beatId": "prompt-handoff",
        "targetComponentId": "prompt-copy",
        "kind": "typewriter",
        "property": "typewriterProgress",
        "startMs": 2800,
        "endMs": 4300,
        "fromValue": 0,
        "toValue": 1,
        "easing": "linear"
      },
      {
        "id": "cards-enter",
        "beatId": "cards-assemble",
        "targetComponentId": "result-cards",
        "kind": "staggeredCardRise",
        "property": "position",
        "startMs": 6100,
        "endMs": 8500,
        "fromValue": "below",
        "toValue": "grid",
        "easing": "slowFastSlow"
      }
